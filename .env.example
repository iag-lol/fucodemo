# Copia este archivo como .env y completa lo que necesites. Todo es opcional.
PORT=4321
HOST=127.0.0.1            # En un servidor público: 0.0.0.0
# NODE_ENV=production     # En producción: no crea la galería de demostración
# ADMIN_PASSWORD=         # Si no se define, se genera una en data/CLAVE-PANEL.txt
# TRUST_PROXY=1           # Solo si hay un proxy delante (Nginx, Render, etc.)
# DATA_DIR=               # Carpeta persistente para solicitudes y galerías

# Aviso por correo de cada solicitud (cuenta en resend.com con el dominio verificado)
# RESEND_API_KEY=
# MAIL_TO=contacto@fucoestudio.com
# MAIL_FROM=Web FUCO <web@fucoestudio.com>

# O bien enviar cada solicitud a un webhook (Zapier, Make, Slack, etc.)
# LEAD_WEBHOOK_URL=
